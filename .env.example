# Groq LPU API Key (Fast Inference: Qwen 3.8 27B Vision)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini Vision API Key (Optional)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_key_here

# xAI Grok Vision API Key (Optional)
# Get key: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Default AI Vision Model (Optional)
# Options: qwen/qwen3.8-27b, gemini-2.0-flash, grok-2-vision-1212
GEMINI_VISION_MODEL=qwen/qwen3.8-27b

# Supabase Storage & Database (Optional - for history persistence)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-or-anon-key
